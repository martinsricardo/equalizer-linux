[Unit]
Description=Equalizador de Som para Linux (PipeWire Background DSP)
Documentation=https://github.com/ricardo/equalizer-linux
After=pipewire.service wireplumber.service equalizer-sink.service
Wants=pipewire.service wireplumber.service equalizer-sink.service
PartOf=pipewire.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c %h/.config/equalizer-linux/pipewire-filter.conf
Restart=always
RestartSec=1s

[Install]
WantedBy=default.target

